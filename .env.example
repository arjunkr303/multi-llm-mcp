# ============================================
# Multi-LLM MCP Gateway — Environment Variables
# ============================================
# Copy this file to .env and replace the placeholder values
# with your actual API keys. NEVER commit the .env file.
#
# .env is listed in .gitignore and should never be tracked.
# ============================================

# NVIDIA NIM API key — https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_key_here

# OpenRouter API key — https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here

# Groq API key — https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here

# DeepSeek API key — https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_key_here